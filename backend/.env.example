# Database configuration
DATABASE_URL=postgresql+psycopg://geni5_crm_user:YOUR_DB_PASSWORD@localhost:5432/geni5_crm

# Authentication
JWT_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Email configuration (optional; replace with your own SMTP credentials)
SMTP_HOST=YOUR_SMTP_HOST
SMTP_PORT=465
SMTP_USER=YOUR_SMTP_USER
SMTP_PASS=YOUR_SMTP_PASSWORD
SMTP_FROM_EMAIL=YOUR_SENDER_EMAIL
SMTP_FROM_NAME=Geni5 CRM

# Application URLs
FRONTEND_BASE_URL=http://localhost:3000

# Token expiration settings
PASSWORD_RESET_EXPIRE_MINUTES=30
INVITATION_EXPIRE_HOURS=24
